MYNOTE_PASSWORD=change-this-password
MYNOTE_DATA_DIR=./data
MYNOTE_PORT=8787
MYNOTE_ORIGIN=http://localhost:5173,http://localhost:1420,http://localhost:8080
MYNOTE_COOKIE_SECURE=false

# S3 版本化备份（腾讯云 COS 的 S3 兼容接口也可使用）
S3_BACKUP_ENABLED=false
# 单独启用定时备份；配置 S3 本身不会启动定时任务
S3_BACKUP_SCHEDULE_ENABLED=false
S3_BACKUP_CONCURRENCY=8
S3_BACKUP_DEBOUNCE_SECONDS=60
S3_BACKUP_MAX_WAIT_SECONDS=600
S3_BACKUP_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
S3_BACKUP_REGION=ap-guangzhou
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
S3_BACKUP_PREFIX=mynote
S3_BACKUP_RETENTION=30
S3_BACKUP_INTERVAL_HOURS=24
S3_BACKUP_VERIFY_INTERVAL_HOURS=168
S3_BACKUP_FORCE_PATH_STYLE=false
S3_BACKUP_SERVER_SIDE_ENCRYPTION=AES256
# 仅在使用 aws:kms 时填写
S3_BACKUP_KMS_KEY_ID=
